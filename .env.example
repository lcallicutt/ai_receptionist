# ─────────────────────────────────────────────────────────────────────────────
# FlowNet AI Receptionist — environment variables
# Copy to .env.local and fill in real values. NEVER commit real credentials.
# All secrets are server-side only; nothing here is exposed to the browser
# unless prefixed with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string. If unset in development, the app falls back
# to an embedded PGlite database stored in .data/ (dev/demo only).
DATABASE_URL=postgres://user:password@host.neon.tech/flownet?sslmode=require

# ── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign session tokens (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string
# Separate key for encrypting stored integration credentials (falls back to AUTH_SECRET)
CREDENTIALS_SECRET=replace-with-another-long-random-string

# ── Telephony + SMS (Twilio or Telnyx via TelephonyProvider adapter) ────────
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WEBHOOK_SIGNING_KEY=your-twilio-signing-key

# ── Voice AI (Retell, Vapi, or Bland via VoiceProvider adapter) ─────────────
VOICE_PROVIDER=retell
RETELL_API_KEY=your-retell-api-key
RETELL_WEBHOOK_SECRET=your-retell-webhook-secret

# ── Calendar (Google Calendar via CalendarProvider adapter) ─────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ── CRM (GoHighLevel or generic webhook via CRMProvider adapter) ────────────
CRM_PROVIDER=webhook
GHL_API_KEY=your-gohighlevel-api-key
GHL_LOCATION_ID=your-gohighlevel-location-id

# ── Email (transactional email via EmailProvider adapter) ───────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=notifications@yourdomain.com

# ── Sample provider webhook (dev/demo ingestion endpoint) ───────────────────
# HMAC key for POST /api/webhooks/sample (see docs/provider-adapters.md)
SAMPLE_WEBHOOK_SECRET=replace-with-a-random-string

# ── Automation (n8n webhooks via AutomationWebhookProvider adapter) ─────────
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/flownet
N8N_WEBHOOK_SECRET=your-n8n-shared-secret

# ── Billing (Stripe — prepared, not yet enabled) ────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
